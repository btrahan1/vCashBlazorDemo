@inject IJSRuntime JS
@using vCashBlazorDemo.Models

@if (ShowDialog)
{
    <div class="modal show" tabindex="-1" style="display: block !important; background-color: rgba(0,0,0,0.5); z-index: 10000;">
        <div class="modal-dialog modal-dialog-centered modal-sm"> <!-- Small width for receipt look -->
            <div class="modal-content shadow-lg border-0 rounded-0">
                <div class="modal-body p-0">
                    
                    <!-- Thermal Receipt Paper Effect -->
                    <div class="bg-white p-3 font-monospace position-relative" style="box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                        
                        <!-- Header -->
                        <div class="text-center mb-3">
                            <i class="bi bi-bank fs-1"></i>
                            <h5 class="fw-bold mb-0">SCORE</h5>
                            <small class="text-muted">Store #4482 - Downtown</small>
                            <div class="small text-muted">@DateTime.Now.ToString("g")</div>
                        </div>

                        <hr class="border-top border-dark border-2 border-dashed my-2" />

                        <!-- Line Items -->
                        <div class="mb-3 small">
                            @foreach (var item in Items)
                            {
                                <div class="d-flex justify-content-between mb-1 @(item.IsVoid ? "text-decoration-line-through text-muted" : "")">
                                    <span class="text-truncate" style="max-width: 140px;">@item.Type</span>
                                    <span>@item.Amount.ToString("N2")</span>
                                </div>
                            }
                        </div>

                        <hr class="border-top border-dark border-2 border-dashed my-2" />

                        <!-- Totals -->
                        <div class="mb-2">
                            <div class="d-flex justify-content-between small">
                                <span>Total Fees:</span>
                                <span>@TotalFees.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span>Cash In:</span>
                                <span>@TotalCashIn.ToString("N2")</span>
                            </div>
                             <div class="d-flex justify-content-between small">
                                <span>Cash Out:</span>
                                <span>@TotalCashOut.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="mt-2 border-top border-dark pt-2">
                            @if (NetPayout > 0)
                            {
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>TOTAL DUE:</span>
                                    <span>@NetPayout.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>CASH RECEIVED:</span>
                                    <span>@TotalCashReceived.ToString("C")</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>PAYOUT:</span>
                                    <span>@Math.Abs(NetPayout).ToString("C")</span>
                                </div>
                            }
                        </div>

                        <!-- Payout / Change Details -->
                        <div class="mt-3 pt-2 border-top border-dashed small">
                            <div class="fw-bold mb-1 text-uppercase text-decoration-underline">
                                @(NetPayout > 0 ? "Change (Bills)" : "Dispensed Cash")
                            </div>
                            @if (NetPayout > 0 && TotalCashReceived > NetPayout)
                            {
                                <div class="d-flex justify-content-between fw-bold text-dark border-bottom pb-1 mb-2">
                                    <span>TOTAL CHANGE:</span>
                                    <span>@((TotalCashReceived - NetPayout).ToString("N2"))</span>
                                </div>
                            }

                            @if(DispensedBills != null && DispensedBills.Any(b => b.Value > 0))
                            {
                                @foreach(var bill in DispensedBills.OrderByDescending(x => x.Key))
                                {
                                    if(bill.Value > 0)
                                    {
                                        <div class="d-flex justify-content-between text-muted">
                                            <span>$@bill.Key bills (x @bill.Value)</span>
                                            <span>@((bill.Key * bill.Value).ToString("N2"))</span>
                                        </div>
                                    }
                                }
                            }
                        </div>
                        
                        @if(Change > 0.005m)
                        {
                            <div class="mt-2 pt-2 border-top border-dark border-dashed small">
                                <div class="fw-bold mb-1 text-uppercase text-decoration-underline">Change (Coins)</div>
                                <div class="d-flex justify-content-between text-muted">
                                    <span>Coin Total:</span>
                                    <span>@Change.ToString("N2")</span>
                                </div>
                            </div>
                        }

                        <!-- Footer -->
                        <div class="text-center mt-4 mb-2">
                            <i class="bi bi-upc-scan fs-1"></i>
                            <div class="small">THANK YOU</div>
                        </div>
                        
                        <!-- Tear Effect (Visual CSS) -->
                        <div class="position-absolute start-0 w-100" style="bottom: -10px; height: 10px; background: radial-gradient(circle, transparent 70%, #fff 75%) 0 0/10px 10px repeat-x;"></div>
                    </div>

                </div>

                @if (!IsPrinting)
                {
                    <!-- Actions -->
                    <div class="bg-light p-2 d-flex gap-2">
                        <button class="btn btn-primary w-100" @onclick="Print">
                            <i class="bi bi-printer"></i> Print
                        </button>
                        <button class="btn btn-secondary w-100" @onclick="Close">
                            Close
                        </button>
                    </div>
                }

                <!-- Printing Simulation Overlay -->
                @if (IsPrinting)
                {
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center px-4 text-center animate-fade-in" 
                         style="background-color: rgba(255,255,255,0.95); z-index: 100; backdrop-filter: blur(4px);">
                        
                        @if (PrintProgress < 100)
                        {
                            <div class="mb-4">
                                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Printing Receipt</h5>
                            <p class="text-muted small mb-4">@PrintStatus</p>
                            
                            <div class="progress w-100" style="height: 6px; border-radius: 3px; background-color: #e9ecef;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" 
                                     role="progressbar" 
                                     style="width: @(PrintProgress)%"></div>
                            </div>
                        }
                        else
                        {
                            <div class="animate-bounce-in mb-3">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-lg" 
                                     style="width: 64px; height: 64px;">
                                    <i class="bi bi-check-lg fs-1"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold text-success mb-1">Print Complete!</h5>
                            <p class="text-muted small">Please collect your receipt from the printer tray.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .animate-bounce-in {
        animation: bounceIn 0.5s cubic-bezier(0.36, 0, 0.66, -0.56) 0s 1 normal forwards;
    }
    @@keyframes bounceIn {
        0% { transform: scale(0.1); opacity: 0; }
        60% { transform: scale(1.2); opacity: 1; }
        100% { transform: scale(1); }
    }
</style>

@code {
    public bool ShowDialog { get; set; }
    
    [Parameter]
    public IEnumerable<TransactionModel> Items { get; set; } = new List<TransactionModel>();
    
    [Parameter]
    public decimal TotalFees { get; set; }
    
    [Parameter]
    public decimal TotalCashIn { get; set; }
    
    [Parameter]
    public decimal TotalCashOut { get; set; }

    [Parameter]
    public decimal NetPayout { get; set; }

    [Parameter]
    public decimal TotalCashReceived { get; set; }

    [Parameter]
    public Dictionary<int, int> DispensedBills { get; set; } = new();

    [Parameter]
    public decimal Change { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsPrinting = false;
    private int PrintProgress = 0;
    private string PrintStatus = "Initializing Printer...";

    public void Show()
    {
        IsPrinting = false;
        PrintProgress = 0;
        ShowDialog = true;
        StateHasChanged();
    }

    public async Task Close()
    {
        ShowDialog = false;
        IsPrinting = false;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
        StateHasChanged();
    }

    private async Task Print()
    {
        IsPrinting = true;
        PrintProgress = 0;
        
        // Phase 1: Connection
        PrintStatus = "Connecting to Star Printer...";
        StateHasChanged();
        await Task.Delay(800);
        PrintProgress = 30;
        
        // Phase 2: Encoding
        PrintStatus = "Encoding Transaction Data...";
        StateHasChanged();
        await Task.Delay(1200);
        PrintProgress = 70;
        
        // Phase 3: Finalizing
        PrintStatus = "Finalizing Print Job...";
        StateHasChanged();
        await Task.Delay(1000);
        PrintProgress = 100;
        StateHasChanged();
        
        // Wait for user to see the success checkmark
        await Task.Delay(1500);
        
        await Close();
    }
}
