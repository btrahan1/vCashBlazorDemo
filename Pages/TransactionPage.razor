    private async Task CompleteCheckout(vCash.Data.Models.BillCounts paidIn)
    {
        IsProcessing = true;
        StateHasChanged();

        // Simulate Hardware Delay
        await Task.Delay(2000);

        var result = await Service.ProcessCashTransaction(paidIn);
        
        // IsProcessing stays true so the overlay remains visible
        // until the user clicks "Proceed" in the overlay itself.

        if (result.Success)
        {
            // Show Receipt
            _receiptItems = Service.GetCart().ToList(); // Copy
            // Snapshoting totals
            var t = Service.GetTotals();
            _receiptTotals = new TransactionTotals 
            { 
                TotalFees = t.TotalFees, 
                CashIn = t.CashIn, 
                CashOut = t.CashOut, 
                NetCash = t.NetCash 
            };
            
            // Check if we need to breakdown change?
            // ProcessCashTransaction returns ChangeCounts (BillCounts).
            // But ReceiptModal expects Dict<int,int>. Map it.
            _receiptBills.Clear();
            if (result.ChangeCounts != null)
            {
                if (result.ChangeCounts.Hundreds > 0) _receiptBills[100] = result.ChangeCounts.Hundreds;
                if (result.ChangeCounts.Fifties > 0) _receiptBills[50] = result.ChangeCounts.Fifties;
                if (result.ChangeCounts.Twenties > 0) _receiptBills[20] = result.ChangeCounts.Twenties;
                if (result.ChangeCounts.Tens > 0) _receiptBills[10] = result.ChangeCounts.Tens;
                if (result.ChangeCounts.Fives > 0) _receiptBills[5] = result.ChangeCounts.Fives;
                if (result.ChangeCounts.Ones > 0) _receiptBills[1] = result.ChangeCounts.Ones;
            }

            IsTransactionSuccess = true;
            // Receipt is now shown via HandleDispenseProceed triggered by Overlay
        }
        else
        {
            IsProcessing = false; // Close overlay on error
            await JS.InvokeVoidAsync("alert", $"Transaction Failed: {result.Message}");
        }
        
        StateHasChanged();
    }

