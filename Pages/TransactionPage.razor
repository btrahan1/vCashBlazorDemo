    private async Task HandleCheckScanAccepted(CheckScanResult result)
    {
        // Populate Inputs
        InputAmount = result.Amount;
        InputRouting = result.RoutingNumber;
        InputAccount = result.AccountNumber;
        InputCheckNum = result.CheckNumber;
        IsCheckScanned = true;

        DetectedMakerName = "Identifying Maker..."; // Immediate UI Feedback

        // Decouple the expensive lookup so the UI/Modal can close cleanly immediately
        _ = LookupMakerAsync(InputRouting, InputAccount);
    }

    private async Task LookupMakerAsync(string rt, string acct)
    {
        try
        {
            // Small delay to ensure Modal close animation clears if needed (optional but smooths UX)
            await Task.Delay(100); 
            
            // Use the location ID we used for scanning, or default to 15
            var maker = await Service.GetMakerAsync(rt, acct, CurrentScanLocationId);
            
            // Marshall back to UI thread
            await InvokeAsync(() =>
            {
                if (maker != null)
                {
                    DetectedMakerName = maker.Name;
                }
                else
                {
                    DetectedMakerName = "Unknown / New Maker";
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lookup Error: {ex.Message}");
            await InvokeAsync(() => 
            {
                DetectedMakerName = $"Error: {ex.Message}";
                StateHasChanged();
            });
        }
    }

    private RiskAssessmentModal RiskModal;
    
    private async Task AddCheckFromInput()
    {
        if (InputAmount <= 0) return;
        
        if (Service.CurrentGuest == null)
        {
            await JS.InvokeVoidAsync("alert", "Please select a guest first.");
            return;
        }

        // 1. Data Gathering
        // In a real scan, these would be populated. For manual/demo, we use inputs.
        // We need to look up Maker and Bank.
        var maker = !string.IsNullOrEmpty(InputRouting) && !string.IsNullOrEmpty(InputAccount) 
                    ? await Service.GetMakerAsync(InputRouting, InputAccount) 
                    : null;
                    
        var bank = !string.IsNullOrEmpty(InputRouting) 
                   ? await Service.GetBankAsync(InputRouting) 
                   : null;

        // 2. Risk Analysis

        // Map GuestModel to Data.Guest for Service Layer
        // Map GuestModel to Data.Guest for Service Layer
        var dataGuest = MapToDataGuest(Service.CurrentGuest);
        var riskResult = await RiskAnalysisService.AnalyzeRiskAsync(InputAmount, dataGuest, maker, bank);

        if (riskResult.NeedsRiskManagement)
        {
            RiskModal.Show(riskResult, maker, bank, InputRouting, InputAccount, InputCheckNum);
            return; // Wait for callback
        }

        // 3. Add to Cart (No Risk)
        Service.AddCheck(InputAmount);
        ClearCheckInputs();
    }
    
