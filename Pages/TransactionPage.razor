    private decimal _receiptChange = 0;

    private void CalculatePayoutDetails(decimal totalAmount)
    {
        _receiptBills.Clear();
        _receiptChange = 0;

        decimal remaining = totalAmount;
        int[] denoms = new[] { 100, 20, 5, 1 };

        foreach (var d in denoms)
        {
            int count = (int)(remaining / d);
            _receiptBills[d] = count;
            remaining -= count * d;
        }

        _receiptChange = remaining;
    }

