
@page "/score/transaction"
@using vCashBlazorDemo.Models
@inject vCashBlazorDemo.Services.TransactionService Service
@inject vCashBlazorDemo.Services.GuestService GuestService
@using vCash.Data.Models
@using vCashBlazorDemo.Modals
@using vCashBlazorDemo.Services
@using vCashBlazorDemo.Pages
@inject RiskService RiskAnalysisService
@implements IDisposable

<AddGuestModal @ref="AddGuest" OnGuestAdded="HandleGuestAdded" />
<RiskAssessmentModal @ref="RiskModal" OnResolving="OnRiskResolved" />

<PageTitle>SCORE POS</PageTitle>

<div class="container-fluid vcash-layout h-100">
    <DispenserOverlay IsVisible="@IsProcessing" IsProcessed="@IsTransactionSuccess" Amount="@NetCash" OnProceed="HandleDispenseProceed" />

    <div class="row h-100">
        <!-- LEFT COLUMN -->
        <div class="col-lg-7 d-flex flex-column gap-2">

            <!-- 1. GUEST INFORMATION PANEL -->
            <div class="card shadow-sm border-info" style="min-height: 180px;">
                <div class="card-header bg-info text-white py-1 small fw-bold">
                    Guest Information@(Service.CurrentGuest != null ? $": {Service.CurrentGuest.FirstName} {Service.CurrentGuest.LastName}" : "")
                </div>
                <div class="card-body p-2 d-flex">
                    <!-- Left: Action Buttons Column -->
                    <div class="d-flex flex-column gap-1 me-3">
                        <button class="btn btn-success btn-sm fw-bold text-wrap border border-light shadow-sm" style="width: 80px; min-height: 60px; background-color: #76ff03; color: #000; border-color: #64dd17;" @onclick="OpenGuestLookup">
                            <i class="bi bi-search d-block fs-5"></i> Guest Lookup
                        </button>
                        <button class="btn btn-light border btn-sm text-wrap fw-bold" style="width: 80px;" @onclick="OpenAddGuest">
                            <i class="bi bi-person-plus d-block"></i> Add New Guest
                        </button>
                        <button class="btn btn-warning border btn-sm text-wrap fw-bold" style="width: 80px;" disabled="@(Service.CurrentGuest == null)" @onclick="EditCurrentGuest">
                            <i class="bi bi-pencil-square d-block"></i> Edit Guest
                        </button>
                        <div class="d-flex gap-1 mt-auto">
                            <button class="btn btn-info btn-sm text-white w-50" title="Info"><i class="bi bi-info-circle"></i></button>
                            <button class="btn btn-danger btn-sm w-50" title="Close"><i class="bi bi-x-circle"></i></button>
                        </div>
                    </div>

                    <!-- Right: Guest Images & Info -->
                    <div class="flex-grow-1 d-flex gap-2 position-relative bg-info bg-opacity-10 p-1 border border-info">
                        @if (Service.CurrentGuest == null)
                        {
                            <!-- Placeholders -->
                            <div class="bg-secondary bg-opacity-25 border d-flex align-items-center justify-content-center text-muted w-50 position-relative">
                                <div class="text-center opacity-50">
                                    <i class="bi bi-person-fill fs-1"></i>
                                    <div>Guest Image</div>
                                </div>
                            </div>
                            <div class="bg-secondary bg-opacity-25 border d-flex align-items-center justify-content-center text-muted w-50 position-relative">
                                <div class="text-center opacity-50">
                                    <i class="bi bi-card-heading fs-1"></i>
                                    <div>Scan Guest ID</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- 1. Guest Photo with Name Badge -->
                            <div class="w-50 position-relative border border-dark bg-dark overflow-hidden d-flex align-items-center justify-content-center">
                                <!-- Removed Name Badge Overlay -->

                                <!-- Guest Image (Using Generated Mock or Real Capture) -->
                                <img src="@(string.IsNullOrEmpty(Service.CurrentGuest.PhotoUrl) ? "images/guest_webcam_photo.png" : Service.CurrentGuest.PhotoUrl)" class="img-fluid w-100 h-100" style="object-fit: cover;" />
                            </div>

                            <!-- 2. ID Card Image -->
                            <div class="w-50 border border-dark bg-secondary d-flex align-items-center justify-content-center overflow-hidden position-relative">
                                <img src="@(string.IsNullOrEmpty(Service.CurrentGuest.PhotoIdUrl) ? "images/guest_id_card_scan.png" : Service.CurrentGuest.PhotoIdUrl)" class="img-fluid w-100" style="object-fit: contain;" />

                                <!-- Scan Overlay Button (Mock) -->
                                @if (Service.CurrentGuest.IsBanned)
                                {
                                    <div class="position-absolute top-50 start-50 translate-middle bg-danger text-white px-3 py-2 fw-bold shadow border border-white">
                                        BANNED
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. TRANSACTION INFORMATION PANEL -->
            <div class="card shadow-sm border-info flex-grow-1">
                <div class="card-header bg-info text-white py-1 small fw-bold">Transaction Information</div>
                <div class="card-body p-2">

                    <!-- Tabs -->
                    <ul class="nav nav-tabs nav-tabs-sm mb-2">
                        <li class="nav-item">
                            <a class="nav-link @(Service.ActiveTab == "Checks" ? "active" : "")" role="button" style="cursor: pointer" @onclick='() => Service.SetActiveTab("Checks")'>Checks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Service.ActiveTab == "MoneyOrder" ? "active" : "")" role="button" style="cursor: pointer" @onclick='() => Service.SetActiveTab("MoneyOrder")'>Money Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Service.ActiveTab == "Wire" ? "active" : "")" role="button" style="cursor: pointer" @onclick='() => Service.SetActiveTab("Wire")'>Wire Transfer</a>
                        </li>
                    </ul>

                    @if (Service.ActiveTab == "Checks")
                    {
                        <!-- Check Inputs Row -->
                        <div class="row g-1 mb-2">
                            <div class="col-auto d-flex flex-column gap-1">
                                <button class="btn btn-light border d-flex flex-column align-items-center justify-content-center p-1" style="width: 80px; height: 80px;" @onclick="OpenScanCheck">
                                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-1">
                                        <!-- Scanner Base -->
                                        <path d="M5 25C5 23.8954 5.89543 23 7 23H33C34.1046 23 35 23.8954 35 25V33C35 34.1046 34.1046 35 33 35H7C5.89543 35 5 34.1046 5 33V25Z" fill="#444"/>
                                        <path d="M5 28H35V31H5V28Z" fill="#333"/>
                                        <!-- Slot -->
                                        <rect x="8" y="23" width="24" height="2" fill="#222"/>
                                        <!-- Check Document -->
                                        <rect x="10" y="8" width="20" height="15" rx="1" fill="white" stroke="#ccc" stroke-width="1"/>
                                        <path d="M12 12H20" stroke="#eee" stroke-width="1"/>
                                        <path d="M12 15H28" stroke="#eee" stroke-width="1"/>
                                        <path d="M12 18H25" stroke="#eee" stroke-width="1"/>
                                        <!-- Scan Line / indicator -->
                                        <rect x="9" y="21" width="22" height="1" fill="#00ff00" opacity="0.5"/>
                                    </svg>
                                    <small class="fw-bold" style="font-size: 0.7rem;">Scan Check</small>
                                </button>
                                
                                <button class="btn btn-dark border d-flex flex-column align-items-center justify-content-center p-1" style="width: 80px; height: 80px;" @onclick="OpenDispenserInventory">
                                    <img src="images/recycler_icon.png" style="width: 40px; height: 40px; object-fit: contain;" />
                                    <small class="fw-bold text-white mt-1" style="font-size: 0.65rem;">Inventory</small>
                                </button>
                            </div>
                            <div class="col">
                                <div class="row g-1">
                                    <div class="col-4">
                                        <label class="small text-muted mb-0">Routing #</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="123456789" @bind="InputRouting" />
                                    </div>
                                    <div class="col-4">
                                        <label class="small text-muted mb-0">Account Number</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="00012345" @bind="InputAccount" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small text-muted mb-0">Check #</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="1001" @bind="InputCheckNum" />
                                    </div>
                                    <div class="col-2">
                                        <label class="small text-muted mb-0">Date</label>
                                        <input type="text" class="form-control form-control-sm" placeholder="12/14/2025" @bind="InputDateString" />
                                    </div>
                                    <div class="col-12 mt-1">
                                        <label class="small text-muted mb-0">Detected Maker</label>
                                        <input type="text" class="form-control form-control-sm bg-light fw-bold text-primary" readonly value="@DetectedMakerName" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Check Image & Amounts Row -->
                        <div class="row g-2 h-100">
                            <!-- Check Image Mockup -->
                            <div class="col-8">
                                <div class="bg-secondary bg-opacity-25 border d-flex align-items-center justify-content-center text-muted position-relative overflow-hidden" style="min-height: 275px; background-color: #e9ecef;">
                                    @if (!IsCheckScanned || InputAmount <= 0)
                                    {
                                        <h3 class="fw-light">Check Image</h3>
                                    }
                                    else
                                    {
                                        <!-- Replicating the Digital Check Visual -->
                                        <div class="bg-white p-4 shadow-sm" style="width: 80%; height: 60%; transform: rotate(-1deg); border: 1px solid #dee2e6;">
                                            <div class="border-bottom pb-2 mb-3 d-flex justify-content-between align-items-end">
                                                <span class="font-monospace small text-muted">Pay to the Order of</span>
                                                <span class="font-monospace fw-bold fs-4">$@InputAmount.ToString("N2")</span>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-center my-4">
                                                <div class="font-cursive fs-1 text-dark" style="font-family: 'Brush Script MT', cursive; transform: rotate(-2deg);">Authorized Payee</div>
                                            </div>
                                            <div class="border-top pt-2 d-flex justify-content-between small text-muted font-monospace mt-auto">
                                                <span>⑆123456789⑆</span>
                                                <span>00012345⑈</span>
                                                <span>1001</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Amount & Add Button -->
                            <div class="col-4 d-flex flex-column gap-2">
                                <div>
                                    <label class="small fw-bold">Chk Amt</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control fw-bold text-end" @bind="InputAmount" />
                                    </div>
                                </div>
                                <div>
                                    <label class="small text-muted">Fee</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control text-end bg-light" readonly value="@((InputAmount * 0.01m).ToString("0.00"))" />
                                    </div>
                                </div>
                                <div>
                                    <label class="small text-muted">Net</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control text-end bg-light" readonly value="@((InputAmount * 0.99m).ToString("0.00"))" />
                                    </div>
                                </div>

                                <div class="d-flex flex-column gap-2 mt-2">
                                    <button class="btn btn-secondary py-2 w-100" @onclick="AddCheckFromInput">
                                        <i class="bi bi-cart-plus"></i> Add to cart
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Money Order Inputs -->
                    @if (Service.ActiveTab == "MoneyOrder")
                    {
                        <div class="row g-3 h-100 align-items-center justify-content-center">
                            <div class="col-12">
                                <div class="card bg-light border-0 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="fw-bold text-dark text-uppercase mb-3 border-bottom pb-2">Money Order</h5>
                                        
                                         <div class="row g-2 align-items-end">
                                            <div class="col-12">
                                                <label class="small fw-bold text-muted">Payee</label>
                                                <input type="text" class="form-control" placeholder="e.g. Utility Co, Landlord" @bind="MoneyOrderPayee" />
                                            </div>
                                            
                                            <div class="col-6">
                                                <label class="small fw-bold text-muted">Amount</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white border-end-0">$</span>
                                                    <input type="number" class="form-control border-start-0 fw-bold" placeholder="0.00" 
                                                           @bind="MoneyOrderAmount" @bind:after="RecalculateMoneyOrder" />
                                                </div>
                                            </div>
                                            
                                            <div class="col-6">
                                                 <label class="small fw-bold text-muted">Total (w/ Fee)</label>
                                                 <div class="input-group">
                                                    <span class="input-group-text bg-light border-end-0 text-muted">$</span>
                                                    <input type="text" class="form-control bg-light border-start-0 fw-bold text-primary" readonly value="@MoneyOrderTotal.ToString("N2")" />
                                                 </div>
                                            </div>

                                             <div class="col-12 d-flex justify-content-between align-items-center mt-2">
                                                 <span class="badge bg-white text-muted border">Fee: @MoneyOrderFee.ToString("C2")</span>
                                                 <div class="d-flex gap-2">
                                                     <button class="btn btn-outline-danger btn-sm" @onclick="ClearMoneyOrderInput">
                                                         <i class="bi bi-x-circle"></i> Clear
                                                     </button>
                                                     <button class="btn btn-primary fw-bold" @onclick="AddMoneyOrder">
                                                        <i class="bi bi-plus-circle me-1"></i> Add to Cart
                                                     </button>
                                                 </div>
                                             </div>
                                         </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Wire Transfer Inputs -->
                    @if (Service.ActiveTab == "Wire")
                    {
                        <div class="row g-3 h-100 align-items-center justify-content-center">
                            <div class="col-12">
                                <div class="card bg-light border-0 shadow-sm">
                                    <div class="card-body">
                                        <h5 class="fw-bold text-dark text-uppercase mb-3 border-bottom pb-2">Wire Transfer</h5>
                                        
                                        <div class="row">
                                            <!-- Validated Radio Types -->
                                            <div class="col-5 border-end pe-4">
                                                <label class="form-label fw-bold text-muted mb-3">Transfer Type</label>
                                                <div class="d-flex flex-column gap-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="wireType" id="sendCash" 
                                                               checked="@(WireType == "SendCash")" 
                                                               @onchange="@(() => SetWireType("SendCash"))">
                                                        <label class="form-check-label fw-bold" for="sendCash">
                                                            Send Cash
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="wireType" id="sendDebit"
                                                               checked="@(WireType == "SendDebit")" 
                                                               @onchange="@(() => SetWireType("SendDebit"))">
                                                        <label class="form-check-label fw-bold" for="sendDebit">
                                                            Send Using Debit Card
                                                        </label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="wireType" id="receiveCheckless"
                                                               checked="@(WireType == "Receive")" 
                                                               @onchange="@(() => SetWireType("Receive"))">
                                                        <label class="form-check-label fw-bold" for="receiveCheckless">
                                                            Receive Checkless
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Dynamic Inputs -->
                                            <div class="col-7 ps-4">
                                                <div class="row g-2">
                                                    
                                                    <!-- Common: Amount -->
                                                    <div class="col-12">
                                                        <label class="small fw-bold text-muted">Amount</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-white border-end-0">$</span>
                                                            <input type="number" class="form-control border-start-0 fw-bold" placeholder="0.00" 
                                                                   @bind="WireAmount" @bind:after="RecalculateWire" />
                                                        </div>
                                                    </div>

                                                    @if (WireType == "SendCash" || WireType == "SendDebit")
                                                    {
                                                        <div class="col-12">
                                                            <label class="small fw-bold text-muted">Fee</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-light border-end-0 text-muted">$</span>
                                                                <input type="number" class="form-control bg-light border-start-0 fw-bold" 
                                                                       @bind="WireFee" />
                                                            </div>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="small fw-bold text-muted">Total</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-light border-end-0 text-muted">$</span>
                                                                <input type="text" class="form-control bg-light border-start-0 fw-bold text-primary" readonly value="@WireTotal.ToString("N2")" />
                                                            </div>
                                                        </div>
                                                    }
                                                    else if (WireType == "Receive")
                                                    {
                                                        <div class="col-12">
                                                            <label class="small fw-bold text-muted">MTCN</label>
                                                            <input type="text" class="form-control fw-bold" placeholder="000-000-0000" @bind="WireMTCN" />
                                                        </div>
                                                    }

                                                    <div class="col-12 mt-3 d-flex gap-2 justify-content-end">
                                                         <button class="btn btn-outline-danger btn-sm" @onclick="ClearWireInput">
                                                             <i class="bi bi-x-circle"></i> Clear
                                                         </button>
                                                         <button class="btn btn-primary fw-bold" @onclick="AddWireTransaction">
                                                            <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                                         </button>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- RIGHT COLUMN: GUEST CART -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white py-1 small fw-bold">Guest Cart</div>
                
                <!-- The Grid -->
                <div class="card-body p-0 d-flex flex-column">
                    <div class="flex-grow-1 bg-white" style="min-height: 300px;">
                    <table class="table table-sm table-bordered mb-0 small">
                        <thead class="bg-primary text-white" style="--bs-bg-opacity: .8;">
                            <tr>
                                <th style="width: 25%;">Transaction Type</th>
                                <th class="text-end" style="width: 15%;">Amount</th>
                                <th class="text-end" style="width: 15%;">Fee</th>
                                <th class="text-end" style="width: 22%;">Cash In</th>
                                <th class="text-end" style="width: 23%;">Cash Out</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in CartItems)
                            {
                                <tr class="@(item.IsVoid ? "text-decoration-line-through text-muted" : "")">
                                    <td class="small">@item.Type</td>
                                    <td class="text-end small">@item.Amount.ToString("0.00")</td>
                                    <td class="text-end small">@item.Fee.ToString("0.00")</td>
                                    <td class="text-end fw-bold @(item.CashIn > 0 ? "text-success" : "text-muted")">
                                        @if(item.CashIn > 0) { @item.CashIn.ToString("0.00") }
                                    </td>
                                    <td class="text-end fw-bold @(item.CashOut > 0 ? "text-danger" : "text-muted")">
                                        @if(item.CashOut > 0) { @item.CashOut.ToString("0.00") }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                    <!-- Totals Bar -->
                    <div class="bg-primary text-white px-2 py-1 d-flex justify-content-between small fw-bold">
                        <span>Totals</span>
                        <div>
                           <span class="me-2" title="Fees">F: @TotalFees.ToString("0.00")</span>
                           <span class="me-2 text-warning" title="Cash In">In: @CartItems.Sum(x => x.CashIn).ToString("0.00")</span>
                           <span class="text-info" title="Cash Out">Out: @CartItems.Sum(x => x.CashOut).ToString("0.00")</span>
                        </div>
                    </div>

                    <!-- Lower Action Area -->
                    <div class="p-3 bg-light border-top">
                        <div class="card border-0 shadow-sm overflow-hidden">
                            <div class="row g-0">
                                <!-- Action Buttons -->
                                <div class="col-5 border-end bg-white d-flex flex-column justify-content-center p-2 gap-2">
                                    <button class="btn btn-success fw-bold py-2 shadow-sm" @onclick="HandleCheckout">
                                        <i class="bi bi-cart-check me-1"></i> Check Out
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm fw-bold py-1" @onclick="ClearCart">
                                        <i class="bi bi-trash me-1"></i> Void All
                                    </button>
                                </div>
                                <!-- Cart Summary -->
                                <div class="col-7 bg-white p-2">
                                    <div class="small">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Cash In</span>
                                            <span class="fw-bold">@CartItems.Sum(x => x.CashIn).ToString("C")</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Cash Out</span>
                                            <span class="fw-bold">@CartItems.Sum(x => x.CashOut).ToString("C")</span>
                                        </div>
                                        <div class="d-flex justify-content-between fw-bold border-top pt-1 mt-1 fs-6">
                                            <span>@(NetCash >= 0 ? "Total Due" : "Guest Receives")</span>
                                            <span class="text-primary">@Math.Abs(NetCash).ToString("C")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Green Footer Bar -->
                    <div class="bg-success text-white p-2 mt-2 fw-bold text-center small">
                        READY TO SCAN
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<GuestLookupModal @ref="GuestLookup" OnGuestSelected="HandleGuestSelected" />
<ScanCheckModal @ref="ScanCheck" OnCheckAccepted="HandleCheckScanAccepted" AvailableMakers="@AvailableMakers" />
<ReceiptModal @ref="Receipt" 
              Items="@_receiptItems"
              TotalFees="@_receiptTotals.TotalFees"
              TotalCashIn="@_receiptTotals.CashIn"
              TotalCashOut="@_receiptTotals.CashOut"
              NetPayout="@_receiptTotals.NetCash"
              DispensedBills="@_receiptBills"
              Change="@_receiptChange"
              OnClose="HandleReceiptClose" />

<CashPaymentModal @ref="CashPaymentModalRef" OnPaymentConfirmed="HandleCashPayment" />
<DispenserInventoryModal @ref="InventoryModal" />

<style>
    .vcash-layout {
        background-color: #f0f2f5;
        padding-top: 10px;
        height: 95vh;
    }

    .nav-tabs-sm .nav-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.4rem;
        font-size: 0.8rem;
    }
</style>

@code {
    private IEnumerable<vCashBlazorDemo.Models.TransactionModel> CartItems => Service.GetCart();
    private decimal TotalFees;
    private decimal NetCash;

    // UI Refs
    private GuestLookupModal GuestLookup;
    private ScanCheckModal ScanCheck = default!;
    
    // UI State
    // SelectedGuest and ActiveTab are now managed by TransactionService
    // UI State
    // SelectedGuest and ActiveTab are now managed by TransactionService
    private decimal InputAmount = 0.00m;
    private string InputRouting { get; set; } = string.Empty;
    private string InputAccount { get; set; } = string.Empty;
    private string InputCheckNum { get; set; } = string.Empty;
