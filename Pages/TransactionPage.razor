    }

    // Checkout
    private void HandleCheckout()
    {
        if (!Service.GetCart().Any()) 
        {
            JS.InvokeVoidAsync("alert", "Cart is empty.");
            return;
        }

        var totals = Service.GetTotals();
        
        // Example: If NetCash > 0, Guest owes us money (e.g. Money Order, Wire Send).
        // If NetCash < 0, We owe guest money (e.g. Check Cashing).
        // If NetCash = 0, Balanced?
        
        if (totals.NetCash > 0)
        {
            // Guest Owes: Must Pay Cash or Card? For Demo assume Cash In.
            // Show Payment Modal
            CashPaymentModalRef.Show(totals.NetCash);
        }
        else if (totals.NetCash < 0)
        {
            // We Owe Guest: Dispense Cash
            // Confirm dispensing?
             CashPaymentModalRef.Show(totals.NetCash); // Reuse modal but it might show "Dispensing..."
        }
        else
        {
            // Zero balance (rare)
            // Just submit
             _ = CompleteCheckout(new vCash.Data.Models.BillCounts());
        }
    }

