    private async Task OpenScanCheck()
    {
        if (AvailableMakers == null || !AvailableMakers.Any())
        {
            // Fetch for Location 2 (Hardcoded default in seed often, or user's specific requirement)
            // Ideally should be dynamic location from Session/Config. 
            // The seed used "2" for LocationId in DRM, but earlier code used "15".
            var locationId = 2; // Default scan location
            var makers = await Service.GetRandomMakersAsync(locationId);
            
            if (makers == null || !makers.Any())
            {
                 makers = await Service.GetRandomMakersAsync(15);
            }
            
            AvailableMakers = makers?.ToList() ?? new List<Maker>();
            CurrentScanLocationId = (AvailableMakers.FirstOrDefault()?.LocationId) as int? ?? 15; 
        }
    
        ScanCheck.Show();
    }
    
