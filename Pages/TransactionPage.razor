    private vCash.Data.Models.Guest MapToDataGuest(vCashBlazorDemo.Models.GuestModel model)
    {
        if (model == null) return null;
        
        int.TryParse(model.Zip, out int zipCode);

        return new vCash.Data.Models.Guest
        {
            GuestId = model.GuestId,
            FirstName = model.FirstName,
            LastName = model.LastName,
            MiddleName = model.MiddleName,
            AddressLine1 = model.Address,
            City = model.City,
            State = model.State,
            Zip = zipCode,
            DrLicNbr = model.DLNumber,
            DrLicState = model.DLState,
            BirthDate = model.BirthDate,
            SSN = model.SSN,
            AccountLimit = model.AccountLimit,
            Blocked = model.IsBanned,
            Comment = model.Notes
        };
    }

