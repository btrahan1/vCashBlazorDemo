@page "/score/help"
@inject IJSRuntime JS

<PageTitle>SCORE Help & Support</PageTitle>

<div class="container-fluid vcash-layout h-100 p-4">
    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Help Center</h2>
            <div class="text-muted small">Troubleshooting, diagnostics, and support resources</div>
        </div>
        <div>
             <button class="btn btn-outline-dark btn-sm" @onclick='() => RunAction("About")'>
                <i class="bi bi-info-circle me-1"></i> About SCORE v2.0
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="row g-4">
        
        <!-- 1. Quick Actions (Hardware & overrides) -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-warning bg-opacity-10 p-2 rounded">
                            <i class="bi bi-lightning-charge text-warning fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Quick Actions</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderHelpItem("Open Cash Drawer", "Manually pop the till drawer.", "bi-box-arrow-up", "Action")
                        @RenderHelpItem("Reprint Last Receipt", "Print the most recent transaction.", "bi-printer", "Action")
                        @RenderHelpItem("Reset Receipt Printer", "Clear jams and reset hardware.", "bi-arrow-clockwise", "Fix")
                        @RenderHelpItem("Recapture Check B/W", "Re-scan last check in grayscale.", "bi-camera", "Fix")
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Diagnostics (Testing) -->
         <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                            <i class="bi bi-cpu text-primary fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Diagnostics</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderHelpItem("Scanner Test", "Run diagnostic pass on check scanner.", "bi-upc-scan", "Test")
                        @RenderHelpItem("Glory Recycler Test", "Test dispenser/recycler hardware.", "bi-cash-coin", "Test")
                        @RenderHelpItem("Network Test", "Ping server and check connectivity.", "bi-wifi", "Test")
                        @RenderHelpItem("Kiosk Mode Toggle", "Switch between Desktop and Kiosk layouts.", "bi-display", "Config")
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Support & Docs -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                         <div class="bg-success bg-opacity-10 p-2 rounded">
                            <i class="bi bi-headset text-success fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Support</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderHelpItem("Corporate Chat", "Start live session with IT support.", "bi-chat-dots", "Live")
                        @RenderHelpItem("Sample Check Guide", "View visual guide for valid checks.", "bi-journal-richtext", "Docs")
                        @RenderHelpItem("WU Parameters", "Western Union configuration reference.", "bi-gear", "Ref")
                        @RenderHelpItem("Submit Ticket", "Report a bug or feature request.", "bi-envelope-plus", "Support")
                    </div>
                </div>
                 <div class="card-footer bg-light border-0">
                    <small class="text-muted"><i class="bi bi-telephone-fill me-1"></i> Helpline: 1-800-555-0199</small>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .vcash-layout {
        background-color: #f0f2f5;
    }
    .list-group-item-action:hover {
        background-color: #f8f9fa;
        padding-left: 1.5rem;
        transition: all 0.2s ease;
    }
    .list-group-item {
        transition: all 0.2s ease;
        border-right: 0;
        border-left: 0;
    }
</style>

@code {
    private RenderFragment RenderHelpItem(string title, string desc, string icon, string tag) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "list-group-item list-group-item-action py-3 d-flex align-items-center gap-3 border-0 border-bottom");
        builder.AddAttribute(2, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => RunAction(title)));

        // Icon Box
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "text-secondary fs-4 d-flex align-items-center justify-content-center");
        builder.AddAttribute(5, "style", "width: 40px;");
        builder.OpenElement(6, "i");
        builder.AddAttribute(7, "class", $"bi {icon}");
        builder.CloseElement();
        builder.CloseElement();

        // Content
        builder.OpenElement(8, "div");
        builder.AddAttribute(9, "class", "flex-grow-1");
        
        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "class", "d-flex justify-content-between align-items-center mb-0");
        builder.OpenElement(12, "span");
        builder.AddAttribute(13, "class", "fw-bold text-dark");
        builder.AddContent(14, title);
        builder.CloseElement();
        
        // Badge
        builder.OpenElement(15, "span");
        builder.AddAttribute(16, "class", "badge bg-light text-secondary border fw-normal");
        builder.AddContent(17, tag);
        builder.CloseElement();
        builder.CloseElement();

        // Description
        builder.OpenElement(18, "div");
        builder.AddAttribute(19, "class", "small text-muted mt-1");
        builder.AddContent(20, desc);
        builder.CloseElement();
        
        builder.CloseElement(); // Content div

        // Chevron
        builder.OpenElement(21, "div");
        builder.AddAttribute(22, "class", "text-muted opacity-25 ms-2");
         builder.OpenElement(23, "i");
        builder.AddAttribute(24, "class", "bi bi-chevron-right");
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement(); // Button
    };

    private async Task RunAction(string actionName)
    {
        await JS.InvokeVoidAsync("alert", $"Executing Action: {actionName}");
    }
}
