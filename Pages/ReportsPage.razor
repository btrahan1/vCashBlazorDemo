@page "/vcash/reports"
@inject IJSRuntime JS

<PageTitle>vCash Reports</PageTitle>

<div class="container-fluid vcash-layout h-100 p-4">
    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Reports Dashboard</h2>
            <div class="text-muted small">Access financial, activity, and audit reports</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => JS.InvokeVoidAsync("alert", "Refreshing Data...")'>
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            <button class="btn btn-primary btn-sm" @onclick='() => JS.InvokeVoidAsync("alert", "Exporting All...")'>
                <i class="bi bi-download me-1"></i> Export All
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="row g-4">
        
        <!-- 1. Activity Reports -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary bg-opacity-10 p-2 rounded">
                            <i class="bi bi-activity text-primary fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Activity</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderReportItem("Transaction Activity", "Daily logs of check cashing and wires.", "bi-list-ul", "Activity")
                        @RenderReportItem("Cashed Check List", "Detailed list of all checks accepted.", "bi-check2-square", "Checks")
                        @RenderReportItem("Cash Payout List", "Summary of cash dispensed to customers.", "bi-cash-coin", "Payouts")
                        @RenderReportItem("Voided Transactions", "Audit log of all voided items.", "bi-x-circle", "Voids")
                        @RenderReportItem("Fee Override Report", "Track manual fee adjustments.", "bi-percent", "Fees")
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Balancing & Cash -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                         <div class="bg-success bg-opacity-10 p-2 rounded">
                            <i class="bi bi-scale text-success fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Balancing</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderReportItem("Daily Balance", " reconcile drawer counts vs system totals.", "bi-wallet2", "Balancing")
                        @RenderReportItem("Drawer count Sheet", "Printable sheet for manual counting.", "bi-printer", "Balancing")
                        @RenderReportItem("End of Day", "Finalize business date and close drawers.", "bi-door-closed", "EOD")
                        @RenderReportItem("Cashier Report", "Performance and error tracking by user.", "bi-person-badge", "Staff")
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Analysis & Audit -->
        <div class="col-md-6 col-lg-4">
             <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-2">
                         <div class="bg-info bg-opacity-10 p-2 rounded">
                            <i class="bi bi-graph-up text-info fs-4"></i>
                        </div>
                        <h5 class="fw-bold mb-0">Analysis & Logs</h5>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @RenderReportItem("Customer Validation", "Identity check logs and ID scans.", "bi-person-check", "Compliance")
                        @RenderReportItem("Blocked Entites", "List of banned makers and guests.", "bi-slash-circle", "Risk")
                        @RenderReportItem("System Audit ", "Technical logs and error reports.", "bi-cpu", "System")
                         @RenderReportItem("FINCEN 104", "Regulatory reporting exports.", "bi-file-earmark-text", "Compliance")
                    </div>
                </div>
                <div class="card-footer bg-light border-0">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Compliance reports auto-generated at midnight.</small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .vcash-layout {
        background-color: #f0f2f5;
    }
    
    /* Hover effect for list items */
    .list-group-item-action:hover {
        background-color: #f8f9fa;
        padding-left: 1.5rem; /* Slide effect */
        transition: all 0.2s ease;
    }
    
    .list-group-item {
        transition: all 0.2s ease;
        border-right: 0;
        border-left: 0;
    }

    .list-group-item:first-child { border-top: 0; }
    .list-group-item:last-child { border-bottom: 0; }
</style>

@code {
    private RenderFragment RenderReportItem(string title, string desc, string icon, string tag) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "list-group-item list-group-item-action py-3 d-flex align-items-start gap-3 border-0 border-bottom");
        builder.AddAttribute(2, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => RunReport(title)));

        // Icon Box
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "text-secondary fs-4");
        builder.OpenElement(5, "i");
        builder.AddAttribute(6, "class", $"bi {icon}");
        builder.CloseElement();
        builder.CloseElement();

        // Content
        builder.OpenElement(7, "div");
        builder.AddAttribute(8, "class", "flex-grow-1");
        
        builder.OpenElement(9, "div");
        builder.AddAttribute(10, "class", "d-flex justify-content-between align-items-center mb-1");
        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", "fw-bold text-dark");
        builder.AddContent(13, title);
        builder.CloseElement();
        
        // Badge
        builder.OpenElement(14, "span");
        builder.AddAttribute(15, "class", "badge bg-light text-secondary border fw-normal");
        builder.AddContent(16, tag);
        builder.CloseElement();
        builder.CloseElement();

        // Description
        builder.OpenElement(17, "div");
        builder.AddAttribute(18, "class", "small text-muted");
        builder.AddContent(19, desc);
        builder.CloseElement();
        
        builder.CloseElement(); // Content div

        // Chevron
        builder.OpenElement(20, "div");
        builder.AddAttribute(21, "class", "text-muted opacity-25 ms-2");
         builder.OpenElement(22, "i");
        builder.AddAttribute(23, "class", "bi bi-chevron-right");
        builder.CloseElement();
        builder.CloseElement();

        builder.CloseElement(); // Button
    };

    private async Task RunReport(string reportName)
    {
        // Placeholder for logic
        await JS.InvokeVoidAsync("alert", $"Generating Report: {reportName}\n\n(This would open the report viewer or print dialog)");
    }
}
