@page "/score/transfers"
@inject IJSRuntime JS
@inject vCashBlazorDemo.Services.TransactionService TransactionService
@using vCashBlazorDemo.Modals
@using vCash.Data.Models

<PageTitle>SCORE Transfers</PageTitle>

<div class="container-fluid vcash-layout h-100 p-4">
    
    <div class="d-flex flex-column h-100">
        
        <!-- Header -->
        <div class="mb-5 text-center">
            <h2 class="fw-bold mb-0 text-dark">Cash Transfers</h2>
            <div class="text-muted">Manage cash movement between devices and couriers</div>
        </div>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@_statusMessage</div>
                <button type="button" class="btn-close" @onclick="() => _statusMessage = null"></button>
            </div>
        }

        <!-- Cards Container -->
        <div class="row g-4 justify-content-center align-items-center flex-grow-1" style="max-height: 700px;">

            <!-- 1. Courier Transfers (Split Load/Pickup) -->
            <div class="col-md-5 col-lg-4">
                <div class="card h-100 border-0 shadow-sm p-4 text-center">
                    <div class="bg-primary bg-opacity-10 p-4 rounded-circle mb-3 mx-auto" style="width: 100px; height: 100px;">
                            <i class="bi bi-truck text-primary fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Courier Transfers</h4>
                    <p class="text-muted small mb-4">Move cash between the armored courier and the recycler.</p>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary py-2 fw-bold shadow-sm" @onclick="() => OpenTransfer(true)">
                            <i class="bi bi-plus-circle me-1"></i> CASH LOAD (+)
                        </button>
                        <button class="btn btn-outline-primary py-2 fw-bold" @onclick="() => OpenTransfer(false)">
                            <i class="bi bi-dash-circle me-1"></i> CASH PICKUP (-)
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. Recap/Internal Transfers Placeholder -->
            <div class="col-md-5 col-lg-4">
                 <div class="card h-100 border-0 shadow-sm p-4 text-center opacity-75">
                    <div class="bg-success bg-opacity-10 p-4 rounded-circle mb-3 mx-auto" style="width: 100px; height: 100px;">
                             <i class="bi bi-safe2 text-success fs-1"></i>
                    </div>
                    <h4 class="fw-bold mb-2">Internal Transfers</h4>
                    <p class="text-muted small mb-4">Balance recycler with cash drawer or drop safe.</p>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-outline-success py-2 fw-bold" disabled>
                            RECYCLER TO DRAWER
                        </button>
                        <button class="btn btn-outline-success py-2 fw-bold" disabled>
                            DRAWER TO DROP
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<CourierTransferModal @ref="_transferModal" OnTransferConfirmed="HandleTransferConfirmed" />

<style>
    .vcash-layout {
        background-color: #f0f2f5;
    }

    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important;
    }
</style>

@code {
    private CourierTransferModal _transferModal;
    private string? _statusMessage;

    private void OpenTransfer(bool isLoad)
    {
        _transferModal.Show(isLoad);
    }

    private async Task HandleTransferConfirmed((BillCounts Counts, bool IsLoad) result)
    {
        var response = await TransactionService.ProcessCourierTransfer(result.Counts, result.IsLoad);
        if (response.Success)
        {
            _statusMessage = $"Successfully {(result.IsLoad ? "loaded" : "picked up")} {result.Counts.Total:C2} via courier.";
            StateHasChanged();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", $"Transfer Failed: {response.Message}");
        }
    }
}
