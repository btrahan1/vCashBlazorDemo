@page "/vcash/transfers"
@inject IJSRuntime JS

<PageTitle>vCash Transfers</PageTitle>

<div class="container-fluid vcash-layout h-100 p-4">
    
    <div class="d-flex flex-column h-100">
        
        <!-- Header -->
        <div class="mb-5 text-center">
            <h2 class="fw-bold mb-0">Cash Transfers</h2>
            <div class="text-muted">Manage cash movement between devices and couriers</div>
        </div>

        <!-- Cards Container -->
        <div class="row g-4 justify-content-center align-items-center flex-grow-1" style="max-height: 600px;">

            <!-- 1. Courier Transfers -->
            <div class="col-md-4" style="max-width: 400px;">
                <button class="card h-100 w-100 border-0 shadow-sm hover-shadow text-start p-4 card-btn" @onclick='() => RunTransfer("Courier Transfers")'>
                    <div class="d-flex flex-column align-items-center text-center gap-3">
                        <div class="bg-primary bg-opacity-10 p-4 rounded-circle mb-2">
                             <i class="bi bi-truck text-primary display-4"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-2">Courier Transfers</h4>
                            <p class="text-muted small mb-0">Manage incoming and outgoing shipments with armored service.</p>
                        </div>
                    </div>
                </button>
            </div>

            <!-- 2. Dispenser to Cash Drawer -->
            <div class="col-md-4" style="max-width: 400px;">
                <button class="card h-100 w-100 border-0 shadow-sm hover-shadow text-start p-4 card-btn" @onclick='() => RunTransfer("Dispenser to Cash Drawer")'>
                    <div class="d-flex flex-column align-items-center text-center gap-3">
                         <div class="bg-success bg-opacity-10 p-4 rounded-circle mb-2 position-relative">
                             <i class="bi bi-safe2 text-success display-4"></i>
                             <i class="bi bi-arrow-down-right-circle-fill text-dark position-absolute bottom-0 end-0 fs-3 border border-white rounded-circle"></i>
                        </div>
                         <div>
                            <h4 class="fw-bold mb-2">Dispenser to Drawer</h4>
                            <p class="text-muted small mb-0">Move cash from the automated recycler to the manual till.</p>
                        </div>
                    </div>
                </button>
            </div>

            <!-- 3. Cash Drawer to Cash Drop -->
            <div class="col-md-4" style="max-width: 400px;">
                <button class="card h-100 w-100 border-0 shadow-sm hover-shadow text-start p-4 card-btn" @onclick='() => RunTransfer("Cash Drawer to Cash Drop")'>
                     <div class="d-flex flex-column align-items-center text-center gap-3">
                        <div class="bg-warning bg-opacity-10 p-4 rounded-circle mb-2 position-relative">
                             <i class="bi bi-box-seam text-warning display-4"></i>
                             <i class="bi bi-arrow-down text-dark position-absolute bottom-0 start-50 translate-middle-x fs-3 border border-white rounded-circle"></i>
                        </div>
                         <div>
                            <h4 class="fw-bold mb-2">Drawer to Drop</h4>
                            <p class="text-muted small mb-0">Secure excess cash from the till into the drop safe.</p>
                        </div>
                    </div>
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .vcash-layout {
        background-color: #f0f2f5;
    }

    .card-btn {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        background: white;
    }

    .card-btn:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

@code {
    private async Task RunTransfer(string type)
    {
        await JS.InvokeVoidAsync("alert", $"Starting Transfer: {type}\n\n(This would open the hardware wizard)");
    }
}
